# =============================================
# AI MOCK INTERVIEW PLATFORM - Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# Server
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/interview_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (use long random strings - min 32 chars each)
JWT_ACCESS_SECRET=your_super_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW_MS=900000

# Cors - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_SERVICE_NAME=interview-backend

# Database Migration (node-pg-migrate)
DATABASE_URL_MIGRATE=postgresql://postgres:yourpassword@localhost:5432/interview_db
